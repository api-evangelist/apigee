{
  "opencollection": "1.0.0",
  "info": {
    "name": "Apigee API Hub Analytics Artifacts API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "authorization_code",
      "authorizationUrl": "https://accounts.google.com/o/oauth2/auth",
      "accessTokenUrl": "https://oauth2.googleapis.com/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Artifacts",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Apigee List Artifacts",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://apihub.googleapis.com/v1/projects/:projectId/locations/:locationId/artifacts",
            "params": [
              {
                "name": "projectId",
                "value": "",
                "type": "path",
                "description": "Google Cloud project ID."
              },
              {
                "name": "locationId",
                "value": "",
                "type": "path",
                "description": "Google Cloud region or location."
              },
              {
                "name": "pageSize",
                "value": "",
                "type": "query",
                "description": "Maximum number of items to return per page."
              },
              {
                "name": "pageToken",
                "value": "",
                "type": "query",
                "description": "Page token returned from a previous list request."
              },
              {
                "name": "filter",
                "value": "",
                "type": "query",
                "description": "Filter expression."
              },
              {
                "name": "orderBy",
                "value": "",
                "type": "query",
                "description": "Field to order results by."
              }
            ]
          },
          "docs": "Lists all artifacts at the specified project/location level."
        },
        {
          "info": {
            "name": "Apigee Create an Artifact",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://apihub.googleapis.com/v1/projects/:projectId/locations/:locationId/artifacts",
            "params": [
              {
                "name": "projectId",
                "value": "",
                "type": "path",
                "description": "Google Cloud project ID."
              },
              {
                "name": "locationId",
                "value": "",
                "type": "path",
                "description": "Google Cloud region or location."
              },
              {
                "name": "artifactId",
                "value": "",
                "type": "query",
                "description": "Required. The ID to use for the artifact."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Creates a new artifact at the project/location level."
        },
        {
          "info": {
            "name": "Apigee Get an Artifact",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://apihub.googleapis.com/v1/projects/:projectId/locations/:locationId/artifacts/:artifactId",
            "params": [
              {
                "name": "projectId",
                "value": "",
                "type": "path",
                "description": "Google Cloud project ID."
              },
              {
                "name": "locationId",
                "value": "",
                "type": "path",
                "description": "Google Cloud region or location."
              },
              {
                "name": "artifactId",
                "value": "",
                "type": "path",
                "description": "ID of the artifact."
              }
            ]
          },
          "docs": "Gets details about a specific artifact."
        },
        {
          "info": {
            "name": "Apigee Replace an Artifact",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://apihub.googleapis.com/v1/projects/:projectId/locations/:locationId/artifacts/:artifactId",
            "params": [
              {
                "name": "projectId",
                "value": "",
                "type": "path",
                "description": "Google Cloud project ID."
              },
              {
                "name": "locationId",
                "value": "",
                "type": "path",
                "description": "Google Cloud region or location."
              },
              {
                "name": "artifactId",
                "value": "",
                "type": "path",
                "description": "ID of the artifact."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Replaces the contents of an existing artifact."
        },
        {
          "info": {
            "name": "Apigee Delete an Artifact",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://apihub.googleapis.com/v1/projects/:projectId/locations/:locationId/artifacts/:artifactId",
            "params": [
              {
                "name": "projectId",
                "value": "",
                "type": "path",
                "description": "Google Cloud project ID."
              },
              {
                "name": "locationId",
                "value": "",
                "type": "path",
                "description": "Google Cloud region or location."
              },
              {
                "name": "artifactId",
                "value": "",
                "type": "path",
                "description": "ID of the artifact."
              }
            ]
          },
          "docs": "Deletes an artifact from the registry."
        },
        {
          "info": {
            "name": "Apigee Get Artifact Contents",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://apihub.googleapis.com/v1/projects/:projectId/locations/:locationId/artifacts/:artifactId:getContents",
            "params": [
              {
                "name": "projectId",
                "value": "",
                "type": "path",
                "description": "Google Cloud project ID."
              },
              {
                "name": "locationId",
                "value": "",
                "type": "path",
                "description": "Google Cloud region or location."
              },
              {
                "name": "artifactId",
                "value": "",
                "type": "path",
                "description": "ID of the artifact."
              }
            ]
          },
          "docs": "Retrieves the raw content of an artifact."
        }
      ]
    }
  ],
  "bundled": true
}