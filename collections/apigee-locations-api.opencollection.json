{
  "opencollection": "1.0.0",
  "info": {
    "name": "Apigee API Hub Analytics Locations API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "authorization_code",
      "authorizationUrl": "https://accounts.google.com/o/oauth2/auth",
      "accessTokenUrl": "https://oauth2.googleapis.com/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Locations",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Apigee Search API Hub Resources",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://apihub.googleapis.com/v1/projects/:projectId/locations/:locationId:searchResources",
            "params": [
              {
                "name": "projectId",
                "value": "",
                "type": "path",
                "description": "Google Cloud project ID."
              },
              {
                "name": "locationId",
                "value": "",
                "type": "path",
                "description": "Google Cloud region or location."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Searches across all resources in the API Hub including APIs, versions, specs, and deployments. Supports full-text search."
        }
      ]
    }
  ],
  "bundled": true
}