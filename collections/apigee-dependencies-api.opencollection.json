{
  "opencollection": "1.0.0",
  "info": {
    "name": "Apigee API Hub Analytics Dependencies API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "authorization_code",
      "authorizationUrl": "https://accounts.google.com/o/oauth2/auth",
      "accessTokenUrl": "https://oauth2.googleapis.com/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Dependencies",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Apigee List Dependencies",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://apihub.googleapis.com/v1/projects/:projectId/locations/:locationId/dependencies",
            "params": [
              {
                "name": "projectId",
                "value": "",
                "type": "path",
                "description": "Google Cloud project ID."
              },
              {
                "name": "locationId",
                "value": "",
                "type": "path",
                "description": "Google Cloud region or location."
              },
              {
                "name": "pageSize",
                "value": "",
                "type": "query",
                "description": "Maximum number of items to return per page."
              },
              {
                "name": "pageToken",
                "value": "",
                "type": "query",
                "description": "Page token returned from a previous list request."
              },
              {
                "name": "filter",
                "value": "",
                "type": "query",
                "description": "Filter expression to narrow the results."
              }
            ]
          },
          "docs": "Lists all API dependencies in the specified project and location. Dependencies represent relationships between APIs."
        },
        {
          "info": {
            "name": "Apigee Create a Dependency",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://apihub.googleapis.com/v1/projects/:projectId/locations/:locationId/dependencies",
            "params": [
              {
                "name": "projectId",
                "value": "",
                "type": "path",
                "description": "Google Cloud project ID."
              },
              {
                "name": "locationId",
                "value": "",
                "type": "path",
                "description": "Google Cloud region or location."
              },
              {
                "name": "dependencyId",
                "value": "",
                "type": "query",
                "description": "Required. The ID to use for the dependency resource."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Creates a new dependency between APIs in the API Hub."
        },
        {
          "info": {
            "name": "Apigee Get a Dependency",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://apihub.googleapis.com/v1/projects/:projectId/locations/:locationId/dependencies/:dependencyId",
            "params": [
              {
                "name": "projectId",
                "value": "",
                "type": "path",
                "description": "Google Cloud project ID."
              },
              {
                "name": "locationId",
                "value": "",
                "type": "path",
                "description": "Google Cloud region or location."
              },
              {
                "name": "dependencyId",
                "value": "",
                "type": "path",
                "description": "ID of the dependency resource."
              }
            ]
          },
          "docs": "Retrieves details about a specific API dependency."
        },
        {
          "info": {
            "name": "Apigee Update a Dependency",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://apihub.googleapis.com/v1/projects/:projectId/locations/:locationId/dependencies/:dependencyId",
            "params": [
              {
                "name": "projectId",
                "value": "",
                "type": "path",
                "description": "Google Cloud project ID."
              },
              {
                "name": "locationId",
                "value": "",
                "type": "path",
                "description": "Google Cloud region or location."
              },
              {
                "name": "dependencyId",
                "value": "",
                "type": "path",
                "description": "ID of the dependency resource."
              },
              {
                "name": "updateMask",
                "value": "",
                "type": "query",
                "description": "Required. Comma-separated list of fields to update."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Updates an existing API dependency."
        },
        {
          "info": {
            "name": "Apigee Delete a Dependency",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://apihub.googleapis.com/v1/projects/:projectId/locations/:locationId/dependencies/:dependencyId",
            "params": [
              {
                "name": "projectId",
                "value": "",
                "type": "path",
                "description": "Google Cloud project ID."
              },
              {
                "name": "locationId",
                "value": "",
                "type": "path",
                "description": "Google Cloud region or location."
              },
              {
                "name": "dependencyId",
                "value": "",
                "type": "path",
                "description": "ID of the dependency resource."
              }
            ]
          },
          "docs": "Deletes an API dependency from the API Hub."
        }
      ]
    }
  ],
  "bundled": true
}