{
  "opencollection": "1.0.0",
  "info": {
    "name": "Apigee API Hub Analytics Observation Sources API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "authorization_code",
      "authorizationUrl": "https://accounts.google.com/o/oauth2/auth",
      "accessTokenUrl": "https://oauth2.googleapis.com/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Observation Sources",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Apigee List Observation Sources",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://apihub.googleapis.com/v1/projects/:projectId/locations/:locationId/observationSources",
            "params": [
              {
                "name": "projectId",
                "value": "",
                "type": "path",
                "description": "Google Cloud project ID."
              },
              {
                "name": "locationId",
                "value": "",
                "type": "path",
                "description": "Google Cloud region or location."
              },
              {
                "name": "pageSize",
                "value": "",
                "type": "query",
                "description": "Maximum number of items to return per page."
              },
              {
                "name": "pageToken",
                "value": "",
                "type": "query",
                "description": "Page token returned from a previous list request."
              }
            ]
          },
          "docs": "Lists all observation sources configured in the specified project and location. Sources define the network infrastructure to monitor."
        },
        {
          "info": {
            "name": "Apigee Create an Observation Source",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://apihub.googleapis.com/v1/projects/:projectId/locations/:locationId/observationSources",
            "params": [
              {
                "name": "projectId",
                "value": "",
                "type": "path",
                "description": "Google Cloud project ID."
              },
              {
                "name": "locationId",
                "value": "",
                "type": "path",
                "description": "Google Cloud region or location."
              },
              {
                "name": "observationSourceId",
                "value": "",
                "type": "query",
                "description": "Required. The ID to use for the observation source."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Creates a new observation source that defines which network infrastructure to monitor for API traffic."
        },
        {
          "info": {
            "name": "Apigee Get an Observation Source",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://apihub.googleapis.com/v1/projects/:projectId/locations/:locationId/observationSources/:observationSourceId",
            "params": [
              {
                "name": "projectId",
                "value": "",
                "type": "path",
                "description": "Google Cloud project ID."
              },
              {
                "name": "locationId",
                "value": "",
                "type": "path",
                "description": "Google Cloud region or location."
              },
              {
                "name": "observationSourceId",
                "value": "",
                "type": "path",
                "description": "ID of the observation source."
              }
            ]
          },
          "docs": "Gets details for a specific observation source."
        },
        {
          "info": {
            "name": "Apigee Delete an Observation Source",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://apihub.googleapis.com/v1/projects/:projectId/locations/:locationId/observationSources/:observationSourceId",
            "params": [
              {
                "name": "projectId",
                "value": "",
                "type": "path",
                "description": "Google Cloud project ID."
              },
              {
                "name": "locationId",
                "value": "",
                "type": "path",
                "description": "Google Cloud region or location."
              },
              {
                "name": "observationSourceId",
                "value": "",
                "type": "path",
                "description": "ID of the observation source."
              }
            ]
          },
          "docs": "Deletes an observation source. The source must not be in use by any active observation jobs."
        }
      ]
    }
  ],
  "bundled": true
}