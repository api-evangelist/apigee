            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://apihub.googleapis.com/v1/projects/:projectId/locations/:locationId/products/:productId/integrations/:integrationId/versions",
            "params": [
              {
                "name": "projectId",
                "value": "",
                "type": "path",
                "description": "Google Cloud project ID."
              },
              {
                "name": "locationId",
                "value": "",
                "type": "path",
                "description": "Google Cloud region or location."
              },
              {
                "name": "productId",
                "value": "",
                "type": "path",
                "description": "Product identifier (typically the Apigee product name)."
              },
              {
                "name": "integrationId",
                "value": "",
                "type": "path",
                "description": "Name of the integration."
              },
              {
                "name": "pageSize",
                "value": "",
