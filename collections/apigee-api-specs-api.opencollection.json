                "description": "ID of the API resource."
              },
              {
                "name": "versionId",
                "value": "",
                "type": "path",
                "description": "ID of the API version."
              },
              {
                "name": "specId",
                "value": "",
                "type": "path",
                "description": "ID of the API spec."
              }
            ]
          },
          "docs": "Gets details about a specific API specification."
        },
        {
          "info": {
            "name": "Apigee Update an API Spec",
            "type": "http"
